\f0\fs24 \cf0 USE Smart_Hospital;\
\
-- All Assessed Hospitals in the USA \
SELECT * FROM Hospital_Data;\
\
CREATE VIEW excel_hospital_KPI AS\
-- Calculating Average Score of Tech-Certified Hospitals\
SELECT \
	State, \
    Measure_ID,\
    Measure_Name,\
	ROUND(AVG(CASE WHEN Is_Tech_Hospital = "Y" THEN Score END),2) AS TECH_SCORE,\
    ROUND(AVG(CASE WHEN Is_Tech_Hospital = "N" THEN Score END),2) AS LEGACY_SCORE,\
-- Calculating the Gap (ROI)\
	ROUND(AVG(CASE WHEN Is_Tech_Hospital = "Y" THEN Score END) -\
    AVG(CASE WHEN Is_Tech_Hospital = "N" THEN Score END),3) AS Safety_Gap_Percent,\
-- Calculating number of hospitals \
	COUNT(DISTINCT Facility_ID) AS Hospital_num\
FROM Hospital_Data\
GROUP BY State, Measure_ID, Measure_Name\
ORDER BY  Safety_Gap_Percent DESC\
;  \
\
\
SELECT *\
FROM excel_hospital_KPI;\
\

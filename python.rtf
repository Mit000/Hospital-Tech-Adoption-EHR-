\f0\fs18 \cf0 \cb2 import pandas as pd\
\
# --- STEP 1: LOAD DATA ---\
print("Loading CMS Datasets...")\
# NOTE: Ensure these filenames match EXACTLY what you uploaded to the sidebar\
comps_df = pd.read_csv('Complications_and_Deaths-Hospital.csv')\
interop_df = pd.read_csv('Promoting_Interoperability-Hospital.csv')\
\
# --- STEP 2: DEFINE TARGET MEASURES ---\
target_measures = [\
    'PSI_90',       # Patient Safety Composite\
    'PSI_04',       # Surgical Deaths\
    'MORT_30_AMI',  # Heart Attack Death Rate\
    'MORT_30_PN',   # Pneumonia Death Rate\
    'COMP_HIP_KNEE' # Hip/Knee Complication Rate\
]\
\
# Filter raw data\
filtered_comps = comps_df[comps_df['Measure ID'].isin(target_measures)].copy()\
\
# --- STEP 3: CLEANING ---\
filtered_comps['Score'] = pd.to_numeric(filtered_comps['Score'], errors='coerce')\
filtered_comps['Denominator'] = pd.to_numeric(filtered_comps['Denominator'], errors='coerce')\
\
# Statistical Filter (>= 25 patients)\
filtered_comps = filtered_comps[filtered_comps['Denominator'] >= 25]\
filtered_comps = filtered_comps.dropna(subset=['Score'])\
\
# --- STEP 4: STANDARDIZE IDs ---\
filtered_comps['Facility ID'] = filtered_comps['Facility ID'].astype(str).str.zfill(6)\
interop_df['Facility ID'] = interop_df['Facility ID'].astype(str).str.zfill(6)\
\
# --- STEP 5: JOIN ---\
final_df = pd.merge(filtered_comps, \
                    interop_df[['Facility ID', 'Meets criteria for promoting interoperability of EHRs', 'State']], \
                    on='Facility ID', \
                    how='left')\
\
final_df['Meets criteria for promoting interoperability of EHRs'] = final_df['Meets criteria for promoting interoperability of EHRs'].fillna('N')\
\
# Rename for Tableau\
final_df = final_df.rename(columns=\{\
    'Facility ID': 'Facility_ID',\
    'Facility Name': 'Hospital_Name',\
    'Measure ID': 'Measure_ID',\
    'Measure Name': 'Measure_Name',\
    'Score': 'Score',\
    'Denominator': 'Patient_Count',\
    'Meets criteria for promoting interoperability of EHRs': 'Is_Tech_Hospital',\
    'State_x': 'State'\
\})\
\
final_df = final_df[['Facility_ID', 'Hospital_Name', 'State', 'Measure_ID', 'Measure_Name', 'Patient_Count', 'Score', 'Is_Tech_Hospital']]\
\
# --- STEP 6: EXPORT ---\
final_df.to_csv('Smart_Hospital_ROI_Analysis.csv', index=False)\
\
